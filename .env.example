# Copy to .env and adjust. Nothing here is required beyond DATABASE_URL to run locally.
# Never put real keys in this file; it is tracked by git.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=5001
# Matches docker-compose.yml (Postgres 17 + pgvector on host port 5433).
DATABASE_URL=postgres://synchat:synchat@127.0.0.1:5433/synchat
# Extra browser origin(s) allowed to call the API, comma-separated. The API's own
# host is always allowed, so in production leave this empty when one server serves
# both the web app and the API. Left unset it is http://localhost:5173 outside production.
CLIENT_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=30
# Set to the number of reverse proxies in front of the API in production (e.g. 1).
TRUST_PROXY=0
# Rate limiting is on by default. Turn it off only on your own machine, e.g. to run
# the e2e/ browser walk-throughs, which sign up many accounts in a row.
# RATE_LIMITS=false

# --- Frontend build (optional) ----------------------------------------------
# Read by Vite when the web app is built or served in development.
# Public address of the site, used for the canonical and Open Graph URLs. Set it for
# a production build (e.g. https://chat.example.com); left unset those tags are
# left out. Defaults to http://localhost:5173 in development.
VITE_SITE_URL=
# Origin of the API, only when the web app is hosted apart from it (e.g. the app on
# Vercel and the API elsewhere). Leave empty when one server serves both.
VITE_API_URL=
# Development only: where the Vite dev server forwards /api, /uploads and the socket.
# VITE_API_TARGET=http://localhost:5001

# --- Image uploads (optional) -----------------------------------------------
# Without these, images are stored on local disk in development and image
# upload is switched off in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI features (optional) -------------------------------------------------
# The lane tidy-up, catch-up, decided-or-open and the questions inbox call an
# outside model: Claude (Anthropic) or Gemini (Google). Set one key. Without a key
# these features are hidden entirely. With one they still stay off in every group
# until that group's admin turns them on, because they send the group's messages
# to that provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
# The model the README's tidy-up accuracy was measured with. A free-tier Gemini key
# allows only a handful of requests a day on the larger models.
GEMINI_MODEL=gemini-3.5-flash-lite
# Only needed when both keys are set: anthropic (default) or google.
# LLM_PROVIDER=google
# The AI pass over a group (tidy the lanes, then summarise the topics that changed)
# runs once the group has been quiet for the first number of seconds, or the third
# after the first unprocessed message in a group that never goes quiet. A topic is
# not summarised more often than the second, however often members ask.
DIGEST_QUIET_SECONDS=90
DIGEST_MIN_INTERVAL_SECONDS=20
DIGEST_MAX_WAIT_SECONDS=600
# Development only: feed the AI screens from a rule-based stand-in (NOT a model),
# to work on them without a key. Ignored in production or when a key is set.
# LLM_STUB=true

# --- Push notifications (optional) --------------------------------------------
# Generate a pair with:  npm run vapid --prefix backend
# Without them the app works, but cannot notify a closed browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Production ---------------------------------------------------------------
# NODE_ENV=production makes the API serve the built frontend (npm run build) and
# marks the session cookie Secure. Browsers accept that on https and on localhost;
# set COOKIE_SECURE=false only to test over plain http on a LAN address.
# COOKIE_SECURE=false
# Migrations run at startup unless this is false (then run: npm run migrate --prefix backend).
# AUTO_MIGRATE=false
# bcrypt work factor for passwords. Never lower than 12 in production.
# BCRYPT_COST=12
# Where local-disk image uploads and the downloaded embedding model are kept.
# UPLOAD_DIR=backend/uploads
# MODEL_CACHE_DIR=backend/.cache/models
# Sentence-embedding model for topic lanes. Changing it means re-embedding stored
# messages, and one with an output size other than 384 also needs a migration.
# EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# --- Tests (optional) ---------------------------------------------------------
# Database for the backend test suite, and the address the e2e walk-throughs open.
# TEST_DATABASE_URL=postgres://synchat:synchat@127.0.0.1:5433/synchat_test
# E2E_BASE_URL=http://localhost:5173
